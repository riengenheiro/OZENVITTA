---
---

<section class="hero" id="inicio">
  <div class="hero__bg">
    <div class="hero__gradient"></div>
  </div>
  
  <div class="container hero__container">
    <div class="hero__content">
      <img 
        src="https://promo.ozenvitta.com/wp-content/uploads/2025/01/LOGO-OZENVITTA.png" 
        alt="OzenVitta Logo" 
        class="hero__logo"
        width="280"
      />
      
      <h1 class="hero__title">
        Controle seu apetite, queime gordura e <span class="text-gradient">emagreça de forma natural!</span>
      </h1>
      
      <p class="hero__description">
        Com OzenVitta, você acelera o seu metabolismo, queima gordura localizada, controla o apetite e ainda ganha mais disposição no seu dia a dia!
      </p>
      
      <div class="hero__features">
        <div class="feature-item">
          <span class="feature-icon">✓</span>
          <span>Fórmula 100% Natural</span>
        </div>
        <div class="feature-item">
          <span class="feature-icon">✓</span>
          <span>Sem Efeitos Colaterais</span>
        </div>
        <div class="feature-item">
          <span class="feature-icon">✓</span>
          <span>Entrega para Todo Brasil</span>
        </div>
      </div>
      
      <a href="#oferta" class="btn btn--primary btn--pulse">
        <span>⚡</span>
        Quero emagrecer de forma natural
      </a>
    </div>
    
    <div class="hero__visual">
      <img 
        src="https://promo.ozenvitta.com/wp-content/uploads/2025/01/FLUT-1.png" 
        alt="" 
        class="hero__floating hero__floating--1 animate-float"
        width="80"
      />
      <img 
        src="https://promo.ozenvitta.com/wp-content/uploads/2025/01/FLUT-2.png" 
        alt="" 
        class="hero__floating hero__floating--2 animate-float"
        style="animation-delay: 0.5s"
        width="100"
      />
      <img 
        src="https://promo.ozenvitta.com/wp-content/uploads/2025/01/FLUT-3.png" 
        alt="" 
        class="hero__floating hero__floating--3 animate-float"
        style="animation-delay: 1s"
        width="70"
      />
      <img 
        src="https://promo.ozenvitta.com/wp-content/uploads/2025/01/POTE-PRINCIPAL.png" 
        alt="Pote OzenVitta" 
        class="hero__product animate-fade-in-up"
        width="450"
      />
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    overflow: hidden;
    padding: 100px 0 60px;
  }

  .hero__bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(135deg, #246EB2 0%, #24356F 100%);
  }

  .hero__gradient {
    position: absolute;
    inset: 0;
    background: 
      radial-gradient(ellipse at top right, rgba(111, 255, 221, 0.1) 0%, transparent 50%),
      radial-gradient(ellipse at bottom left, rgba(36, 53, 111, 0.5) 0%, transparent 50%);
  }

  .hero__container {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: center;
  }

  .hero__content {
    color: white;
  }

  .hero__logo {
    margin-bottom: 24px;
    filter: brightness(0) invert(1);
  }

  .hero__title {
    font-size: clamp(32px, 4vw, 48px);
    font-weight: 700;
    line-height: 1.2;
    margin-bottom: 24px;
  }

  .hero__description {
    font-size: 18px;
    line-height: 1.6;
    margin-bottom: 32px;
    opacity: 0.95;
    max-width: 500px;
  }

  .hero__features {
    display: flex;
    flex-wrap: wrap;
    gap: 16px 24px;
    margin-bottom: 32px;
  }

  .feature-item {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    font-weight: 500;
  }

  .feature-icon {
    width: 20px;
    height: 20px;
    background: var(--color-accent);
    color: var(--color-dark);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 12px;
    font-weight: 700;
  }

  .btn--pulse {
    animation: pulse 2s ease-in-out infinite;
  }

  .hero__visual {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .hero__product {
    position: relative;
    z-index: 2;
    filter: drop-shadow(0 20px 40px rgba(0, 0, 0, 0.3));
  }

  .hero__floating {
    position: absolute;
    z-index: 1;
    opacity: 0.9;
    filter: drop-shadow(0 10px 20px rgba(0, 0, 0, 0.2));
  }

  .hero__floating--1 {
    top: 10%;
    left: 0;
  }

  .hero__floating--2 {
    top: 60%;
    left: -5%;
  }

  .hero__floating--3 {
    top: 20%;
    right: 0;
  }

  @media (max-width: 992px) {
    .hero__container {
      grid-template-columns: 1fr;
      text-align: center;
      gap: 40px;
    }

    .hero__logo {
      margin: 0 auto 24px;
    }

    .hero__description {
      margin: 0 auto 32px;
    }

    .hero__features {
      justify-content: center;
    }

    .hero__product {
      width: 300px;
    }

    .hero__floating {
      display: none;
    }
  }

  @media (max-width: 768px) {
    .hero {
      padding-top: 80px;
    }

    .hero__product {
      width: 250px;
    }
  }
</style>
