---
import { media } from '../../data/media';

const { hero, backgrounds } = media;
const bg = backgrounds.hero.desktop;
---

<section class="hero" id="inicio" style={`background-image: url('${bg}')`}>
  <div class="hero__bg">
    <div class="hero__gradient"></div>
  </div>
  
  <div class="container hero__container">
    <div class="hero__content">
      <img
        src={hero.logo}
        alt="OzenVitta Logo"
        class="hero__logo"
        width="280"
        height="80"
        fetchpriority="high"
        decoding="async"
      />
      
      <h1 class="hero__title">
        Você já tentou de tudo para emagrecer...<br>
        <span class="text-gradient">e nada funcionou de verdade?</span>
      </h1>
      
      <div class="hero__letter short-lines">
        <p>Então leia cada palavra desta página.</p>
        <p>Porque o que você vai descobrir agora<br>
        já mudou a vida de <strong>milhares de mulheres</strong><br>
        que estavam exatamente onde você está.</p>
        <p>Cansadas. Frustradas. Sem esperança.</p>
        <p>Até encontrarem uma fórmula 100% natural<br>
        que <strong>finalmente</strong> fez a balança se mover.</p>
      </div>

      <div class="hero__features">
        {hero.features.map((feature) => (
          <div class="feature-item">
            <img src={feature.icon} alt="" class="feature-item__icon" width="20" height="20" />
            <span set:html={feature.title} />
          </div>
        ))}
      </div>
      
      <a href="#oferta" class="btn btn--primary btn--pulse">
        <span>⚡</span>
        Quero descobrir o segredo agora
      </a>
    </div>
    
    <div class="hero__visual">
      <img 
        src={hero.floating[0]}
        alt="" 
        class="hero__floating hero__floating--1 animate-float"
        width="80"
      />
      <img 
        src={hero.floating[2]}
        alt="" 
        class="hero__floating hero__floating--2 animate-float"
        style="animation-delay: 0.5s"
        width="100"
      />
      <img 
        src={hero.floating[1]}
        alt="" 
        class="hero__floating hero__floating--3 animate-float"
        style="animation-delay: 1s"
        width="70"
      />
      <img
        src={hero.product}
        alt="Pote OzenVitta"
        class="hero__product animate-fade-in-up"
        width="450"
        height="450"
        fetchpriority="high"
        decoding="async"
      />
      <img 
        src={hero.productAlt}
        alt="" 
        class="hero__product-alt"
        width="200"
        aria-hidden="true"
      />
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    overflow: hidden;
    padding: 100px 0 60px;
    background-size: cover;
    background-position: center;
  }

  .hero__bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(135deg, rgba(36, 110, 178, 0.85) 0%, rgba(36, 53, 111, 0.9) 100%);
  }

  .hero__gradient {
    position: absolute;
    inset: 0;
    background: 
      radial-gradient(ellipse at top right, rgba(111, 255, 221, 0.1) 0%, transparent 50%),
      radial-gradient(ellipse at bottom left, rgba(36, 53, 111, 0.5) 0%, transparent 50%);
  }

  .hero__container {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: center;
  }

  .hero__content {
    color: white;
  }

  .hero__logo {
    margin-bottom: 24px;
    filter: brightness(0) invert(1);
  }

  .hero__title {
    font-size: clamp(32px, 4vw, 48px);
    font-weight: 700;
    line-height: 1.2;
    margin-bottom: 24px;
  }

  .hero__letter {
    margin-bottom: 32px;
    max-width: 520px;
  }

  .hero__letter p {
    font-size: 18px;
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.95);
  }

  .hero__letter strong {
    color: var(--color-accent);
  }

  .hero__features {
    display: flex;
    flex-wrap: wrap;
    gap: 16px 24px;
    margin-bottom: 32px;
  }

  .feature-item {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    font-weight: 500;
  }

  .feature-item__icon {
    flex-shrink: 0;
  }

  .btn--pulse {
    animation: pulse 2s ease-in-out infinite;
  }

  .hero__visual {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .hero__product {
    position: relative;
    z-index: 2;
    filter: drop-shadow(0 20px 40px rgba(0, 0, 0, 0.3));
  }

  .hero__product-alt {
    position: absolute;
    right: 0;
    bottom: 0;
    z-index: 1;
    opacity: 0.9;
  }

  .hero__floating {
    position: absolute;
    z-index: 1;
    opacity: 0.9;
    filter: drop-shadow(0 10px 20px rgba(0, 0, 0, 0.2));
  }

  .hero__floating--1 { top: 10%; left: 0; }
  .hero__floating--2 { top: 60%; left: -5%; }
  .hero__floating--3 { top: 20%; right: 0; }

  @media (max-width: 992px) {
    .hero__container {
      grid-template-columns: 1fr;
      text-align: center;
      gap: 40px;
    }
    .hero__logo { margin: 0 auto 24px; }
    .hero__description { margin: 0 auto 32px; }
    .hero__features { justify-content: center; }
    .hero__product { width: 300px; }
    .hero__product-alt { display: none; }
    .hero__floating { display: none; }
  }

  @media (max-width: 768px) {
    .hero { padding-top: 80px; }
    .hero__product { width: 250px; }
  }
</style>
