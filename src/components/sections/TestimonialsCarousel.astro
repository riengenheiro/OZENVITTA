---

<section class="testimonials-carousel section section--light" id="depoimentos-carousel">
  <div class="container">
    <div class="testimonials-carousel__header text-center">
      <span class="section-label">DEPOIMENTOS</span>
      <h2 class="section-title">
        Pessoas que estão<br>
        usando o <span class="text-gradient">OzenVitta</span>
      </h2>
    </div>

    <div class="testimonials-carousel__grid">
      <div class="testimonial-card">
        <div class="testimonial-card__video">
          <div class="video-placeholder">
            <svg viewBox="0 0 24 24" fill="currentColor" width="48">
              <path d="M8 5v14l11-7z"/>
            </svg>
          </div>
        </div>
        <div class="testimonial-card__info">
          <h4>Maria S.</h4>
          <p>Perdeu 12kg em 3 meses</p>
        </div>
      </div>

      <div class="testimonial-card">
        <div class="testimonial-card__video">
          <div class="video-placeholder">
            <svg viewBox="0 0 24 24" fill="currentColor" width="48">
              <path d="M8 5v14l11-7z"/>
            </svg>
          </div>
        </div>
        <div class="testimonial-card__info">
          <h4>Ana Paula</h4>
          <p>Conquistou o corpo dos sonhos</p>
        </div>
      </div>

      <div class="testimonial-card">
        <div class="testimonial-card__video">
          <div class="video-placeholder">
            <svg viewBox="0 0 24 24" fill="currentColor" width="48">
              <path d="M8 5v14l11-7z"/>
            </svg>
          </div>
        </div>
        <div class="testimonial-card__info">
          <h4>Carolina M.</h4>
          <p>Ganhou disposição e saúde</p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .testimonials-carousel__header {
    margin-bottom: 64px;
  }

  .testimonials-carousel__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .testimonial-card {
    background: white;
    border-radius: 24px;
    overflow: hidden;
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.08);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .testimonial-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.12);
  }

  .testimonial-card__video {
    aspect-ratio: 16/9;
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-dark) 100%);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .video-placeholder {
    width: 64px;
    height: 64px;
    background: rgba(255, 255, 255, 0.2);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    cursor: pointer;
    transition: transform 0.3s ease, background 0.3s ease;
  }

  .video-placeholder:hover {
    transform: scale(1.1);
    background: rgba(255, 255, 255, 0.3);
  }

  .testimonial-card__info {
    padding: 24px;
    text-align: center;
  }

  .testimonial-card__info h4 {
    font-size: 18px;
    font-weight: 700;
    color: var(--color-dark);
    margin-bottom: 4px;
  }

  .testimonial-card__info p {
    font-size: 14px;
    color: var(--color-text-light);
  }

  @media (max-width: 768px) {
    .testimonials-carousel__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
