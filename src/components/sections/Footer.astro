---
import { media } from '../../data/media';

const { footer } = media;
---

<footer class="footer section--dark">
  <div class="container">
    <div class="footer__grid">
      <div class="footer__brand">
        <img src={footer.logo} alt="OzenVitta" class="footer__logo" width="180" height="60" loading="lazy" decoding="async" />
        <p class="footer__tagline">A decisão que muda tudo começa aqui.</p>
      </div>

      <div class="footer__links">
        <h4>Links</h4>
        <ul>
          <li><a href="#inicio">Início</a></li>
          <li><a href="#beneficios">Benefícios</a></li>
          <li><a href="#ingredientes">Ingredientes</a></li>
          <li><a href="#depoimentos">Depoimentos</a></li>
          <li><a href="#oferta">Oferta</a></li>
        </ul>
      </div>

      <div class="footer__warning">
        <h4>Aviso</h4>
        <p>Não comercializamos o OzenVitta no Mercado Livre, Shopee, ou outras plataformas de terceiros. A venda é exclusiva deste site oficial.</p>
      </div>

      <div class="footer__payment">
        <h4>Formas de pagamento</h4>
        <img src={footer.payment} alt="Formas de pagamento" class="payment-methods" width="200" height="77" loading="lazy" decoding="async" />
      </div>

      <div class="footer__security">
        <h4>Site seguro</h4>
        <img src={footer.security} alt="Site seguro" class="security-badge" width="120" height="60" loading="lazy" decoding="async" />
      </div>
    </div>

    <div class="footer__bottom">
      <p>&copy; 2025 OzenVitta. Todos os direitos reservados.</p>
      <p class="footer__legal">
        <a href="https://ozenvitta.com/politica-de-privacidade/" target="_blank" rel="noopener noreferrer">Política de Privacidade</a>
        <span class="divider">|</span>
        <a href="https://ozenvitta.com/termos-e-condicoes/" target="_blank" rel="noopener noreferrer">Termos e Condições</a>
        <span class="divider">|</span>
        <a href="#garantia">Garantia de 30 Dias</a>
      </p>
      <p>Este site não é afiliado ao Facebook, Instagram ou Google.</p>
    </div>
  </div>
</footer>

<style>
  .footer { padding: 80px 0 40px; color: white; }

  .footer__grid {
    display: grid;
    grid-template-columns: 2fr 1fr 2fr 1.5fr 1fr;
    gap: 40px;
    margin-bottom: 60px;
  }

  .footer__logo { filter: brightness(0) invert(1); margin-bottom: 16px; }
  .footer__tagline { font-size: 14px; opacity: 0.8; max-width: 280px; }

  .footer__links h4,
  .footer__warning h4,
  .footer__payment h4,
  .footer__security h4 {
    font-size: 16px;
    font-weight: 700;
    margin-bottom: 20px;
    color: var(--color-accent);
  }

  .footer__links ul { display: grid; gap: 12px; }
  .footer__links a { font-size: 14px; opacity: 0.8; transition: opacity 0.3s ease; }
  .footer__links a:hover { opacity: 1; color: var(--color-accent); }
  .footer__warning p { font-size: 13px; opacity: 0.7; line-height: 1.5; }

  .footer__bottom {
    text-align: center;
    padding-top: 40px;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }

  .footer__bottom p { font-size: 12px; opacity: 0.6; margin-bottom: 8px; }

  .footer__legal {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
  }

  .footer__legal a {
    color: var(--color-accent);
    opacity: 0.8;
    transition: opacity 0.2s ease;
    text-decoration: none;
  }

  .footer__legal a:hover {
    opacity: 1;
    text-decoration: underline;
  }

  .footer__legal .divider {
    opacity: 0.4;
  }

  @media (max-width: 992px) {
    .footer__grid { grid-template-columns: repeat(2, 1fr); }
    .footer__brand { grid-column: 1 / -1; text-align: center; }
    .footer__tagline { max-width: 100%; }
  }

  @media (max-width: 576px) {
    .footer__grid { grid-template-columns: 1fr; text-align: center; }
    .footer__logo { margin: 0 auto 16px; }
    .payment-methods, .security-badge { margin: 0 auto; }
  }
</style>
