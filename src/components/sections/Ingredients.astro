---
import { media } from '../../data/media';

const { ingredients, ingredientsCarousel, backgrounds } = media;
const bg = backgrounds.ingredients;
---

<section 
  class="ingredients section" 
  id="ingredientes"
  style={`--bg-desktop: url('${bg.desktop}')`}
>
  <div class="ingredients__overlay"></div>
  
  <div class="container ingredients__container">
    <div class="ingredients__header text-center">
      <span class="section-label">O SEGREDO DA FÓRMULA</span>
      <h2 class="section-title text-white">Por que o OzenVitta <span class="text-gradient">funciona de verdade?</span></h2>
      
      <div class="ingredients__story letter-block letter-block--white text-center short-lines">
        <p>Existe um motivo pelo qual outras fórmulas falham.</p>
        <p>Elas atacam apenas <strong>um</strong> dos problemas.</p>
        <p>&nbsp;</p>
        <p>O OzenVitta é diferente.</p>
        <p>&nbsp;</p>
        <p>São <strong>12 ingredientes naturais</strong> trabalhando juntos.</p>
        <p>Cada um com uma função específica.</p>
        <p>Cada um potencializando o efeito do outro.</p>
        <p>&nbsp;</p>
        <p>Conheça os principais:</p>
      </div>
    </div>

    <div class="ingredients__grid">
      {ingredients.map((item) => (
        <div class="ingredient-card">
          <img src={item.image} alt={item.name} loading="lazy" width="64" height="64" decoding="async" />
          <h3>{item.name}</h3>
          <p>{item.description}</p>
        </div>
      ))}
    </div>

    <div class="ingredients-carousel">
      <div class="ingredients-carousel__track">
        {ingredientsCarousel.map((src) => (
          <img src={src} alt="" class="ingredients-carousel__slide" loading="lazy" width="120" height="120" decoding="async" />
        ))}
      </div>
    </div>

    <div class="text-center ingredients__cta">
      <p class="ingredients__closing">Tudo isso em uma única cápsula.<br>Sem química. Sem efeitos colaterais. <strong>100% natural.</strong></p>
      <a href="#oferta" class="btn btn--primary">Quero experimentar agora</a>
    </div>
  </div>
</section>

<style>
  .ingredients {
    background-image: var(--bg-desktop);
    background-size: cover;
    background-position: center;
    position: relative;
    min-height: 80vh;
  }

  .ingredients__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(36, 110, 178, 0.9) 0%, rgba(36, 53, 111, 0.95) 100%);
  }

  .ingredients__container { position: relative; z-index: 1; }
  .ingredients__header { margin-bottom: 64px; }

  .ingredients__story {
    margin-top: 24px;
  }

  .ingredients__story p {
    font-size: 18px;
    color: rgba(255, 255, 255, 0.9);
  }

  .ingredients__story strong {
    color: var(--color-accent);
  }

  .ingredients__closing {
    font-size: 18px;
    color: white;
    margin-bottom: 24px;
    line-height: 1.7;
  }

  .ingredients__closing strong {
    color: var(--color-accent);
  }

  .ingredients__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
  }

  .ingredient-card {
    background: rgba(255, 255, 255, 0.95);
    border-radius: 16px;
    padding: 24px 16px;
    text-align: center;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .ingredient-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.2);
  }

  .ingredient-card img {
    width: 64px;
    height: 64px;
    margin: 0 auto 16px;
    object-fit: contain;
  }

  .ingredient-card h3 {
    font-size: 16px;
    font-weight: 700;
    color: var(--color-dark);
    margin-bottom: 8px;
  }

  .ingredient-card p {
    font-size: 13px;
    color: var(--color-text-light);
    line-height: 1.4;
  }

  .ingredients-carousel {
    margin-top: 48px;
    overflow: hidden;
    border-radius: 16px;
  }

  .ingredients-carousel__track {
    display: flex;
    gap: 16px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding: 8px 0;
    -webkit-overflow-scrolling: touch;
  }

  .ingredients-carousel__slide {
    flex: 0 0 auto;
    height: 120px;
    width: auto;
    scroll-snap-align: start;
    border-radius: 12px;
    object-fit: contain;
    background: rgba(255, 255, 255, 0.1);
    padding: 8px;
  }

  .ingredients__cta { margin-top: 48px; position: relative; z-index: 1; }

  @media (max-width: 992px) {
    .ingredients__grid { grid-template-columns: repeat(3, 1fr); }
  }

  @media (max-width: 768px) {
    .ingredients__grid { display: none; }
    .ingredients-carousel { display: block; }
  }

  @media (min-width: 769px) {
    .ingredients-carousel { display: none; }
  }

  @media (max-width: 480px) {
    .ingredients__grid { grid-template-columns: 1fr; }
  }
</style>
