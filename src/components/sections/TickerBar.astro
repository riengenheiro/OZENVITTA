<style>
  .ticker-bar {
    background: var(--color-secondary);
    padding: 16px 0;
    overflow: hidden;
  }

  .ticker-wrapper {
    display: flex;
    width: max-content;
    animation: ticker 20s linear infinite;
  }

  .ticker-content {
    display: flex;
    align-items: center;
    gap: 24px;
    padding-right: 24px;
    white-space: nowrap;
  }

  .ticker-content span {
    font-size: 16px;
    font-weight: 700;
    color: var(--color-dark);
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .ticker-dot {
    color: var(--color-dark) !important;
    opacity: 0.5;
  }

  @keyframes ticker {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  @media (max-width: 768px) {
    .ticker-content span {
      font-size: 14px;
    }
  }
</style>
