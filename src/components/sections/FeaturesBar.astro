---
import { media } from '../../data/media';
---

<section class="features-bar">
  <div class="container">
    <div class="features-bar__grid">
      {media.featuresBar.map((item) => (
        <div class="feature-box">
          <div class="feature-box__icon">
            <img src={item.icon} alt="" width="32" height="32" />
          </div>
          <div class="feature-box__content">
            <h3 set:html={item.title} />
            <p>{item.description}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .features-bar {
    background: var(--color-dark);
    padding: 40px 0;
  }

  .features-bar__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
  }

  .feature-box {
    display: flex;
    align-items: center;
    gap: 16px;
    color: white;
  }

  .feature-box__icon {
    width: 48px;
    height: 48px;
    background: rgba(111, 255, 221, 0.1);
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .feature-box__content h3 {
    font-size: 16px;
    font-weight: 600;
    margin-bottom: 4px;
  }

  .feature-box__content p {
    font-size: 14px;
    opacity: 0.8;
  }

  @media (max-width: 768px) {
    .features-bar__grid {
      grid-template-columns: 1fr;
      gap: 24px;
    }
  }
</style>
