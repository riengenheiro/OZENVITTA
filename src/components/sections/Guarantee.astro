<section class="guarantee section section--light" id="garantia">
  <div class="container">
    <div class="guarantee__content text-center">
      <img 
        src="https://promo.ozenvitta.com/wp-content/uploads/2025/01/GARANTIA-30-DIAS.png" 
        alt="Garantia 30 Dias" 
        class="guarantee__badge"
        width="200"
      />
      
      <h2 class="guarantee__title">Garantia de 30 dias</h2>
      
      <p class="guarantee__text">
        Seu pedido está 100% protegido com a nossa Garantia de Satisfação. Se você não ficar satisfeita com os resultados, devolvemos seu dinheiro. Simples assim!
      </p>
    </div>
  </div>
</section>

<style>
  .guarantee {
    padding: 80px 0;
  }

  .guarantee__content {
    max-width: 700px;
    margin: 0 auto;
  }

  .guarantee__badge {
    margin: 0 auto 32px;
  }

  .guarantee__title {
    font-size: 32px;
    font-weight: 700;
    color: var(--color-dark);
    margin-bottom: 20px;
  }

  .guarantee__text {
    font-size: 18px;
    color: var(--color-text-light);
    line-height: 1.6;
  }

  @media (max-width: 768px) {
    .guarantee__title {
      font-size: 24px;
    }

    .guarantee__text {
      font-size: 16px;
    }
  }
</style>
