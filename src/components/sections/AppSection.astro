---
import { media } from '../../data/media';

const { app, backgrounds } = media;
const bg = backgrounds.app;

const appFeatures = [
  { title: 'Aulas com Nutricionista:', text: 'Receba orientações sobre alimentação saudável e dicas práticas.' },
  { title: 'Treinos com Personal:', text: 'Aulas em vídeo práticas para você treinar em casa ou na academia.' },
  { title: 'Grupo de Apoio:', text: 'Conecte-se com outras mulheres na mesma jornada de transformação.' },
  { title: 'Conteúdo Exclusivo:', text: 'O app é constantemente atualizado com dicas, vídeos e novidades.' },
];
---

<section 
  class="app-section section" 
  id="aplicativo"
  style={`--bg-desktop: url('${bg.desktop}'); --bg-mobile: url('${bg.mobile || bg.desktop}')`}
>
  <div class="container app-section__container">
    <div class="app-section__content">
      <div class="app-section__header">
        <span class="section-label">APLICATIVO</span>
        <h2 class="section-title">
          Transforme sua jornada com o <br>
          <span class="text-gradient">aplicativo exclusivo OzenVitta!</span>
        </h2>
        <p class="app-section__intro">
          Com o nosso aplicativo exclusivo, você terá acesso a ferramentas incríveis para potencializar seus resultados.
        </p>
      </div>

      <div class="app-features">
        {appFeatures.map((feature) => (
          <div class="app-feature">
            <img src={app.bullets} alt="" width="40" />
            <h3>{feature.title}</h3>
            <p>{feature.text}</p>
          </div>
        ))}
      </div>
    </div>

    <div class="app-section__visual">
      <img src={app.mockup} alt="Aplicativo OzenVitta" class="app-mockup" width="400" loading="lazy" />
      {app.floating.map((src, i) => (
        <img 
          src={src} 
          alt="" 
          class={`app-floating app-floating--${i + 1} animate-float`}
          style={i === 1 ? 'animation-delay: 0.5s' : undefined}
          width={i === 0 ? 60 : 80}
          loading="lazy"
        />
      ))}
    </div>
  </div>
</section>

<style>
  .app-section {
    background-image: var(--bg-desktop);
    background-size: cover;
    background-position: center;
    min-height: 80vh;
    display: flex;
    align-items: center;
  }

  @media (max-width: 768px) {
    .app-section { background-image: var(--bg-mobile); }
  }

  .app-section__container {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: center;
  }

  .app-section__header { margin-bottom: 48px; }

  .app-section__intro {
    font-size: 18px;
    color: var(--color-text-light);
    margin-top: 24px;
    max-width: 500px;
  }

  .app-features { display: grid; gap: 24px; }

  .app-feature { display: flex; flex-direction: column; gap: 8px; }
  .app-feature h3 { font-size: 18px; font-weight: 700; color: var(--color-dark); }
  .app-feature p { font-size: 15px; color: var(--color-text-light); line-height: 1.5; }

  .app-section__visual {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .app-mockup {
    position: relative;
    z-index: 2;
    filter: drop-shadow(0 20px 40px rgba(0, 0, 0, 0.2));
  }

  .app-floating { position: absolute; opacity: 0.6; }
  .app-floating--1 { left: 0; top: 20%; }
  .app-floating--2 { right: 0; bottom: 20%; }

  @media (max-width: 992px) {
    .app-section__container { grid-template-columns: 1fr; gap: 40px; }
    .app-section__visual { order: -1; }
    .app-mockup { width: 300px; }
    .app-floating { display: none; }
  }

  @media (max-width: 768px) {
    .app-mockup { width: 250px; }
  }
</style>
