---
import { media } from '../../data/media';

const { testimonials, backgrounds } = media;
const bg = backgrounds.testimonials;
---

<section 
  class="testimonials section" 
  id="depoimentos"
  style={`--bg-desktop: url('${bg.desktop}'); --bg-mobile: url('${bg.mobile || bg.desktop}')`}
>
  <div class="testimonials__overlay"></div>
  
  <div class="container testimonials__container">
    <div class="testimonials__header text-center">
      <span class="section-label">RESULTADOS REAIS</span>
      <h2 class="section-title text-white">
        Essas mulheres estavam <span class="text-gradient">desesperançadas.</span>
      </h2>
      <div class="testimonials__intro letter-block letter-block--white text-center short-lines">
        <p>Elas já tinham tentado de tudo.</p>
        <p>Dietas. Remédios. Chás milagrosos.</p>
        <p>Nada funcionava.</p>
        <p>&nbsp;</p>
        <p>Até que descobriram o OzenVitta.</p>
        <p>Veja com seus próprios olhos o que aconteceu:</p>
      </div>
    </div>

    <div class="testimonials__grid">
      {testimonials.map((src) => (
        <div class="testimonial-item">
          <img src={src} alt="Depoimento OzenVitta" class="testimonial-image" width="400" height="300" loading="lazy" decoding="async" />
        </div>
      ))}
    </div>

    <div class="text-center testimonials__cta">
      <p class="testimonials__closing">Essas mulheres tomaram uma decisão.<br><strong>E você?</strong></p>
      <a href="#oferta" class="btn btn--primary">Quero ser a próxima</a>
    </div>
  </div>
</section>

<style>
  .testimonials {
    background-image: var(--bg-desktop);
    background-size: cover;
    background-position: center;
    position: relative;
    min-height: 80vh;
    display: flex;
    align-items: center;
  }

  @media (max-width: 768px) {
    .testimonials { background-image: var(--bg-mobile); }
  }

  .testimonials__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(17, 25, 52, 0.95) 0%, rgba(17, 25, 52, 0.85) 100%);
  }

  .testimonials__container { position: relative; z-index: 1; }
  .testimonials__header { margin-bottom: 64px; }

  .testimonials__intro {
    margin-top: 24px;
  }

  .testimonials__intro p {
    font-size: 18px;
    color: rgba(255, 255, 255, 0.9);
  }

  .testimonials__cta { margin-top: 48px; position: relative; z-index: 1; }

  .testimonials__closing {
    font-size: 20px;
    color: white;
    margin-bottom: 24px;
    line-height: 1.6;
  }

  .testimonials__closing strong {
    color: var(--color-accent);
    font-size: 24px;
  }

  .testimonials__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .testimonial-item {
    background: rgba(255, 255, 255, 0.05);
    border-radius: 16px;
    overflow: hidden;
    transition: transform 0.3s ease;
  }

  .testimonial-item:hover { transform: translateY(-8px); }
  .testimonial-image { width: 100%; height: auto; object-fit: cover; }

  @media (max-width: 992px) {
    .testimonials__grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 576px) {
    .testimonials__grid { grid-template-columns: 1fr; }
  }
</style>
