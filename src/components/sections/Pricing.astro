---
import { media } from '../../data/media';

const { pricing, backgrounds } = media;
const bg = backgrounds.pricing.desktop;

const kits = [
  { name: 'Pote Único', supply: 'SUPLEMENTO PARA 30 DIAS', installment: 'R$14,76', cash: 'R$147', btnClass: 'btn--primary', popular: false },
  { name: 'Pacote Econômico', supply: 'SUPLEMENTO PARA 90 DIAS', installment: 'R$19,78', cash: 'R$197', btnClass: 'btn--white', popular: true },
  { name: 'Pacote Familiar', supply: 'SUPLEMENTO PARA 150 DIAS', installment: 'R$24,80', cash: 'R$247', btnClass: 'btn--primary', popular: false },
  { name: 'Pacote Máximo', supply: 'SUPLEMENTO PARA 240 DIAS', installment: 'R$37,85', cash: 'R$377', btnClass: 'btn--primary', popular: false },
];
---

<section class="pricing section" id="oferta" style={`background-image: url('${bg}')`}>
  <div class="pricing__overlay"></div>
  
  <div class="container pricing__container">
    <div class="pricing__header text-center">
      <span class="section-label pricing__label">KIT OZENVITTA</span>
      <h2 class="section-title text-white">
        Escolha seu Kit com <br><span class="text-gradient">Desconto Especial</span>
      </h2>
    </div>

    <div class="pricing__grid">
      {kits.map((kit, i) => (
        <div class:list={['pricing-card', { 'pricing-card--popular': kit.popular }]}>
          {kit.popular && <div class="pricing-card__badge">MAIS POPULAR</div>}
          {i === 0 && (
            <div class="pricing-card__bonus">
              <h4>Bônus Inclusos</h4>
              <ul>
                <li>Acesso ao Aplicativo Premium.</li>
                <li>Programa de Emagrecimento.</li>
                <li>Grupo VIP de Apoio.</li>
              </ul>
            </div>
          )}
          <img src={pricing.pots[i]} alt={kit.name} class="pricing-card__image" width="180" loading="lazy" />
          <span class="pricing-card__tag" set:html={kit.name.replace(' ', '<br>')} />
          <div class="pricing-card__supply">{kit.supply}</div>
          <div class="pricing-card__price">
            <p class="price-installment">12X <strong>{kit.installment}</strong></p>
            <p class="price-cash">ou {kit.cash} à vista no pix</p>
          </div>
          <a href="#" class:list={['btn', kit.btnClass, 'btn--full']}>
            ⚡ COMECE A EMAGRECER AGORA
          </a>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .pricing {
    position: relative;
    min-height: 100vh;
    background-size: cover;
    background-position: center;
  }

  .pricing__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(36, 110, 178, 0.95) 0%, rgba(36, 53, 111, 0.98) 100%);
  }

  .pricing__container { position: relative; z-index: 1; }
  .pricing__header { margin-bottom: 64px; }
  .pricing__label { color: white; }

  .pricing__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
  }

  .pricing-card {
    background: white;
    border-radius: 24px;
    padding: 32px 24px;
    text-align: center;
    position: relative;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    display: flex;
    flex-direction: column;
  }

  .pricing-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
  }

  .pricing-card--popular {
    transform: scale(1.05);
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.2);
    border: 2px solid var(--color-accent);
  }

  .pricing-card__badge {
    position: absolute;
    top: -12px;
    left: 50%;
    transform: translateX(-50%);
    background: var(--color-accent);
    color: var(--color-dark);
    padding: 8px 20px;
    border-radius: 50px;
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
  }

  .pricing-card__bonus {
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-dark) 100%);
    color: white;
    border-radius: 12px;
    padding: 16px;
    margin-bottom: 16px;
    text-align: left;
    font-size: 12px;
  }

  .pricing-card__bonus h4 { font-size: 14px; margin-bottom: 8px; }
  .pricing-card__image { margin: 0 auto 16px; height: 180px; object-fit: contain; }
  .pricing-card__tag { font-size: 14px; font-weight: 600; color: var(--color-text-light); text-transform: uppercase; margin-bottom: 8px; }
  .pricing-card__supply {
    background: var(--color-dark);
    color: white;
    padding: 8px 16px;
    border-radius: 50px;
    font-size: 12px;
    font-weight: 600;
    margin-bottom: 16px;
    display: inline-block;
  }

  .price-installment { font-size: 16px; color: var(--color-text-light); margin-bottom: 4px; }
  .price-installment strong { font-size: 32px; color: var(--color-secondary); font-weight: 800; }
  .price-cash { font-size: 14px; color: var(--color-text-light); margin-bottom: 20px; }

  @media (max-width: 1200px) {
    .pricing__grid { grid-template-columns: repeat(2, 1fr); }
    .pricing-card--popular { transform: scale(1); }
  }

  @media (max-width: 576px) {
    .pricing__grid { grid-template-columns: 1fr; }
  }
</style>
