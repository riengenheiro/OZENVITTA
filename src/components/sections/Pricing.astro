<section class="pricing section" id="oferta" style="background-image: url('https://promo.ozenvitta.com/wp-content/uploads/2025/01/4-DOBRA-OZENPHARMA.jpg'); background-size: cover; background-position: center;">
  <div class="pricing__overlay"></div>
  
  <div class="container pricing__container">
    <div class="pricing__header text-center">
      <span class="section-label" style="color: white;">KIT OZENVITTA</span>
      <h2 class="section-title text-white">
        Escolha seu Kit com <br><span class="text-gradient">Desconto Especial</span>
      </h2>
    </div>

    <div class="pricing__grid">
      <!-- Pote Único -->
      <div class="pricing-card">
        <div class="pricing-card__bonus">
          <h4>Bônus Inclusos</h4>
