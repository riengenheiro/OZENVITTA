            <li>Acesso ao Aplicativo Premium.</li>
            <li>Programa de Emagrecimento.</li>
            <li>Grupo VIP de Apoio.</li>
          </ul>
        </div>
        <img 
          src="https://promo.ozenvitta.com/wp-content/uploads/2025/02/POTE-UNICO.png" 
          alt="Pote Único OzenVitta" 
          class="pricing-card__image"
          width="180"
        />
        <span class="pricing-card__tag">Pote Único</span>
        <div class="pricing-card__supply">SUPLEMENTO PARA 30 DIAS</div>
        <div class="pricing-card__price">
          <p class="price-installment">12X <strong>R$14,76</strong></p>
          <p class="price-cash">ou R$147 à vista no pix</p>
        </div>
        <a href="#" class="btn btn--primary btn--full">
          ⚡ COMECE A EMAGRECER AGORA
        </a>
        <ul class="pricing-card__features">
          <li>✓ 1 Pote OzenVitta</li>
          <li>✓ Acesso ao App</li>
          <li>✓ Garantia 30 dias</li>
        </ul>
      </div>

      <!-- Pacote Econômico -->
      <div class="pricing-card pricing-card--popular">
        <div class="pricing-card__badge">MAIS POPULAR</div>
        <img 
          src="https://promo.ozenvitta.com/wp-content/uploads/2025/01/POTE-KIT-3.png" 
          alt="Kit com 3 Potes OzenVitta" 
          class="pricing-card__image"
          width="200"
        />
        <span class="pricing-card__tag">Pacote Econômico</span>
        <div class="pricing-card__supply">SUPLEMENTO PARA 90 DIAS</div>
        <div class="pricing-card__price">
          <p class="price-installment">12X <strong>R$19,78</strong></p>
          <p class="price-cash">ou R$197 à vista no pix</p>
        </div>
        <a href="#" class="btn btn--white btn--full">
          ⚡ COMECE A EMAGRECER AGORA
        </a>
        <ul class="pricing-card__features">
          <li>✓ 3 Potes OzenVitta</li>
          <li>✓ Acesso ao App</li>
          <li>✓ Garantia 30 dias</li>
          <li>✓ Frete Grátis</li>
        </ul>
      </div>

      <!-- Pacote Familiar -->
      <div class="pricing-card">
        <img 
          src="https://promo.ozenvitta.com/wp-content/uploads/2025/01/POTE-KIT-5.png" 
          alt="Kit com 5 Potes OzenVitta" 
          class="pricing-card__image"
          width="200"
        />
        <span class="pricing-card__tag">Pacote Familiar</span>
        <div class="pricing-card__supply">SUPLEMENTO PARA 150 DIAS</div>
        <div class="pricing-card__price">
          <p class="price-installment">12X <strong>R$24,80</strong></p>
          <p class="price-cash">ou R$247 à vista no pix</p>
        </div>
        <a href="#" class="btn btn--primary btn--full">
          ⚡ COMECE A EMAGRECER AGORA
        </a>
        <ul class="pricing-card__features">
          <li>✓ 5 Potes OzenVitta</li>
          <li>✓ Acesso ao App</li>
          <li>✓ Garantia 30 dias</li>
          <li>✓ Frete Grátis</li>
          <li>✓ Brinde Exclusivo</li>
        </ul>
      </div>

      <!-- Pacote Máximo -->
      <div class="pricing-card">
        <img 
          src="https://promo.ozenvitta.com/wp-content/uploads/2025/01/POTE-KIT-8.png" 
          alt="Kit com 8 Potes OzenVitta" 
          class="pricing-card__image"
          width="200"
        />
        <span class="pricing-card__tag">Pacote Máximo</span>
        <div class="pricing-card__supply">SUPLEMENTO PARA 240 DIAS</div>
        <div class="pricing-card__price">
          <p class="price-installment">12X <strong>R$37,85</strong></p>
          <p class="price-cash">ou R$377 à vista no pix</p>
        </div>
        <a href="#" class="btn btn--primary btn--full">
          ⚡ COMECE A EMAGRECER AGORA
        </a>
        <ul class="pricing-card__features">
          <li>✓ 8 Potes OzenVitta</li>
          <li>✓ Acesso ao App</li>
          <li>✓ Garantia 30 dias</li>
          <li>✓ Frete Grátis</li>
          <li>✓ 2 Brindes Exclusivos</li>
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .pricing {
    position: relative;
    min-height: 100vh;
  }

  .pricing__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(36, 110, 178, 0.95) 0%, rgba(36, 53, 111, 0.98) 100%);
  }

  .pricing__container {
    position: relative;
    z-index: 1;
  }

  .pricing__header {
    margin-bottom: 64px;
  }

  .pricing__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
  }

  .pricing-card {
    background: white;
    border-radius: 24px;
    padding: 32px 24px;
    text-align: center;
    position: relative;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    display: flex;
    flex-direction: column;
  }

  .pricing-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
  }

  .pricing-card--popular {
    transform: scale(1.05);
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.2);
    border: 2px solid var(--color-accent);
  }

  .pricing-card--popular:hover {
    transform: scale(1.05) translateY(-8px);
  }

  .pricing-card__badge {
    position: absolute;
    top: -12px;
    left: 50%;
    transform: translateX(-50%);
    background: var(--color-accent);
    color: var(--color-dark);
    padding: 8px 20px;
    border-radius: 50px;
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .pricing-card__bonus {
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-dark) 100%);
    color: white;
    border-radius: 12px;
    padding: 16px;
    margin-bottom: 16px;
    text-align: left;
  }

  .pricing-card__bonus h4 {
    font-size: 14px;
    font-weight: 700;
    margin-bottom: 8px;
  }

  .pricing-card__bonus ul {
    font-size: 12px;
    opacity: 0.9;
  }

  .pricing-card__bonus li {
    margin-bottom: 4px;
    padding-left: 12px;
    position: relative;
  }

  .pricing-card__bonus li::before {
    content: '•';
    position: absolute;
    left: 0;
  }

  .pricing-card__image {
    margin: 0 auto 16px;
    height: 180px;
    object-fit: contain;
  }

  .pricing-card__tag {
    font-size: 14px;
    font-weight: 600;
    color: var(--color-text-light);
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 8px;
  }

  .pricing-card__supply {
    background: var(--color-dark);
    color: white;
    padding: 8px 16px;
    border-radius: 50px;
    font-size: 12px;
    font-weight: 600;
    margin-bottom: 16px;
    display: inline-block;
  }

  .pricing-card__price {
    margin-bottom: 20px;
  }

  .price-installment {
    font-size: 16px;
    color: var(--color-text-light);
    margin-bottom: 4px;
  }

  .price-installment strong {
    font-size: 32px;
    color: var(--color-secondary);
    font-weight: 800;
  }

  .price-cash {
    font-size: 14px;
    color: var(--color-text-light);
  }

  .pricing-card__features {
    margin-top: 20px;
    text-align: left;
    font-size: 13px;
    color: var(--color-text-light);
  }

  .pricing-card__features li {
    margin-bottom: 8px;
    padding-left: 4px;
  }

  @media (max-width: 1200px) {
    .pricing__grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .pricing-card--popular {
      transform: scale(1);
    }

    .pricing-card--popular:hover {
      transform: scale(1) translateY(-8px);
    }
  }

  @media (max-width: 576px) {
    .pricing__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
