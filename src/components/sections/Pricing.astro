---
import { media } from '../../data/media';

const { pricing, backgrounds } = media;
const bg = backgrounds.pricing.desktop;

const kits = [
  {
    name: 'Pote Único',
    pots: 1,
    image: pricing.pots[0],
    supply: 'SUPLEMENTO PARA 30 DIAS',
    installment: 'R$14,76',
    cash: 'R$147',
    checkout: 'https://app.monetizze.com.br/r/ACL25792886?u=c&pl=HV290570',
    btnClass: 'btn--primary',
    popular: false,
  },
  {
    name: 'Pacote Econômico',
    pots: 3,
    image: pricing.pots[1],
    supply: 'SUPLEMENTO PARA 90 DIAS',
    installment: 'R$19,78',
    cash: 'R$197',
    checkout: 'https://app.monetizze.com.br/r/ACL25792886?u=c&pl=DS290571',
    btnClass: 'btn--white',
    popular: true,
  },
  {
    name: 'Pacote Familiar',
    pots: 5,
    image: pricing.pots[2],
    supply: 'SUPLEMENTO PARA 150 DIAS',
    installment: 'R$24,80',
    cash: 'R$247',
    checkout: 'https://app.monetizze.com.br/r/ACL25792886?u=c&pl=NT290572',
    btnClass: 'btn--primary',
    popular: false,
  },
];
---

<section class="pricing section" id="oferta" style={`background-image: url('${bg}')`}>
  <div class="pricing__overlay"></div>
  
  <div class="container pricing__container">
    <div class="pricing__header text-center">
      <span class="section-label pricing__label">SUA OPORTUNIDADE</span>
      <h2 class="section-title text-white">
        Quanto vale <span class="text-gradient">transformar sua vida?</span>
      </h2>
      
      <div class="pricing__buildup letter-block letter-block--white text-center short-lines">
        <p>Pense comigo...</p>
        <p>&nbsp;</p>
        <p>Uma consulta com nutricionista custa R$200 a R$500.</p>
        <p>Um personal trainer, R$150 por mês.</p>
        <p>Remédios para emagrecer, R$300 ou mais.</p>
        <p>&nbsp;</p>
        <p>E mesmo assim... <strong>nenhuma garantia de resultado.</strong></p>
        <p>&nbsp;</p>
        <p>Com o OzenVitta, você investe uma fração desse valor.</p>
        <p>E tem <strong>30 dias de garantia total.</strong></p>
        <p>&nbsp;</p>
        <p>Veja as opções:</p>
      </div>
    </div>

    <div class="pricing__grid">
      {kits.map((kit, i) => (
        <div class:list={['pricing-card', { 'pricing-card--popular': kit.popular }]}>
          {kit.popular && <div class="pricing-card__badge">MAIS POPULAR</div>}
          {i === 0 && (
            <div class="pricing-card__bonus">
              <h4>Bônus Inclusos</h4>
              <ul>
                <li>Acesso ao Aplicativo Premium.</li>
                <li>Programa de Emagrecimento.</li>
                <li>Grupo VIP de Apoio.</li>
              </ul>
            </div>
          )}
          <img src={kit.image} alt={`${kit.pots} ${kit.pots === 1 ? 'pote' : 'potes'} OzenVitta`} class="pricing-card__image" width="180" height="180" loading="lazy" decoding="async" />
          <span class="pricing-card__tag" set:html={kit.name.replace(' ', '<br>')} />
          <div class="pricing-card__supply">{kit.supply}</div>
          <div class="pricing-card__price">
            <p class="price-installment">12X <strong>{kit.installment}</strong></p>
            <p class="price-cash">ou {kit.cash} à vista no pix</p>
          </div>
          <a href={kit.checkout} class:list={['pricing-card__btn', kit.btnClass === 'btn--white' ? 'btn--cta' : 'btn--cta']} target="_blank" rel="noopener noreferrer">
            <span class="btn-icon">⚡</span>
            <span class="btn-text">QUERO COMEÇAR AGORA</span>
          </a>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .pricing {
    position: relative;
    min-height: 100vh;
    background-size: cover;
    background-position: center;
  }

  .pricing__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(36, 110, 178, 0.95) 0%, rgba(36, 53, 111, 0.98) 100%);
  }

  .pricing__container { position: relative; z-index: 1; }
  .pricing__header { margin-bottom: 64px; }

  .pricing__buildup {
    margin-top: 24px;
  }

  .pricing__buildup p {
    font-size: 18px;
    color: rgba(255, 255, 255, 0.9);
  }

  .pricing__buildup strong {
    color: var(--color-accent);
  }
  .pricing__label { color: white; }

  .pricing__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    max-width: 1100px;
    margin: 0 auto;
  }

  .pricing-card {
    background: white;
    border-radius: 24px;
    padding: 32px 24px;
    text-align: center;
    position: relative;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    display: flex;
    flex-direction: column;
  }

  .pricing-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
  }

  .pricing-card--popular {
    transform: scale(1.05);
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.2);
    border: 2px solid var(--color-accent);
  }

  .pricing-card__badge {
    position: absolute;
    top: -12px;
    left: 50%;
    transform: translateX(-50%);
    background: var(--color-accent);
    color: var(--color-dark);
    padding: 8px 20px;
    border-radius: 50px;
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
  }

  .pricing-card__bonus {
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-dark) 100%);
    color: white;
    border-radius: 12px;
    padding: 16px;
    margin-bottom: 16px;
    text-align: left;
    font-size: 12px;
  }

  .pricing-card__bonus h4 { font-size: 14px; margin-bottom: 8px; }
  .pricing-card__image { margin: 0 auto 16px; height: 180px; object-fit: contain; }
  .pricing-card__tag { font-size: 14px; font-weight: 600; color: var(--color-text-light); text-transform: uppercase; margin-bottom: 8px; }
  .pricing-card__supply {
    background: var(--color-dark);
    color: white;
    padding: 8px 16px;
    border-radius: 50px;
    font-size: 12px;
    font-weight: 600;
    margin-bottom: 16px;
    display: inline-block;
  }

  .price-installment { font-size: 16px; color: var(--color-text-light); margin-bottom: 4px; }
  .price-installment strong { font-size: 32px; color: var(--color-secondary); font-weight: 800; }
  .price-cash { font-size: 14px; color: var(--color-text-light); margin-bottom: 20px; }

  .pricing-card__btn {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 4px;
    width: 100%;
    padding: 18px 24px;
    border-radius: 50px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    transition: all 0.3s ease;
    text-decoration: none;
    border: 3px solid var(--color-accent);
    background: linear-gradient(135deg, #20DFB1 0%, #6FFFDD 100%);
    color: var(--color-dark);
    box-shadow: 0 8px 32px rgba(32, 223, 177, 0.4), 0 4px 16px rgba(0, 0, 0, 0.2);
    animation: pulse-glow 2s ease-in-out infinite;
    margin-top: auto;
  }

  .pricing-card__btn:hover {
    transform: translateY(-3px) scale(1.02);
    box-shadow: 0 12px 40px rgba(32, 223, 177, 0.5), 0 6px 20px rgba(0, 0, 0, 0.25);
  }

  .pricing-card__btn .btn-icon {
    font-size: 20px;
    display: inline-block;
    animation: pulse-scale 1.5s ease-in-out infinite;
  }

  @keyframes pulse-scale {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.1); }
  }

  .pricing-card__btn .btn-text {
    font-size: 15px;
    line-height: 1.2;
  }

  @keyframes pulse-glow {
    0%, 100% {
      transform: scale(1);
      box-shadow: 0 8px 32px rgba(32, 223, 177, 0.4), 0 4px 16px rgba(0, 0, 0, 0.2);
    }
    50% {
      transform: scale(1.02);
      box-shadow: 0 12px 40px rgba(32, 223, 177, 0.6), 0 6px 24px rgba(0, 0, 0, 0.3);
    }
  }

  @media (max-width: 992px) {
    .pricing__grid { grid-template-columns: 1fr; max-width: 400px; }
    .pricing-card--popular { transform: scale(1); }
  }

  @media (max-width: 576px) {
    .pricing__grid { grid-template-columns: 1fr; }
  }
</style>
