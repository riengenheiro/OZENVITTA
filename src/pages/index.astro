---
import Layout from '../layouts/Layout.astro';
import HeroSection from '../components/sections/HeroSection.astro';
import FeaturesBar from '../components/sections/FeaturesBar.astro';
import HowItWorks from '../components/sections/HowItWorks.astro';
import TickerBar from '../components/sections/TickerBar.astro';
import Benefits from '../components/sections/Benefits.astro';
import Testimonials from '../components/sections/Testimonials.astro';
import Ingredients from '../components/sections/Ingredients.astro';
import AppSection from '../components/sections/AppSection.astro';
import GradientDivider from '../components/sections/GradientDivider.astro';
import WhyApp from '../components/sections/WhyApp.astro';
import TestimonialsCarousel from '../components/sections/TestimonialsCarousel.astro';
import Pricing from '../components/sections/Pricing.astro';
import Guarantee from '../components/sections/Guarantee.astro';
import FAQ from '../components/sections/FAQ.astro';
import Footer from '../components/sections/Footer.astro';
---

<Layout 
  title="OzenVitta - Emagreça de Forma Natural | Site Oficial"
  description="Com OzenVitta, você acelera o seu metabolismo, queima gordura localizada, controla o apetite e ainda ganha mais disposição no seu dia a dia! Fórmula 100% Natural."
>
  <main>
    <!-- Hero Section - Banner Principal -->
    <HeroSection />
    
    <!-- Features Bar - Segurança, Entrega, Garantia -->
    <FeaturesBar />
    
    <!-- Como Funciona -->
    <HowItWorks />
    
    <!-- Ticker Bar - 100% Natural -->
    <TickerBar />
    
    <!-- Benefícios -->
    <Benefits />
    
    <!-- Depoimentos - Resultados -->
    <Testimonials />
    
    <!-- Ingredientes -->
    <Ingredients />
    
    <!-- Aplicativo -->
    <AppSection />
    
    <!-- Divisor Gradient -->
    <GradientDivider />
    
    <!-- Por que o App -->
    <WhyApp />
    
    <!-- Depoimentos em Vídeo -->
    <TestimonialsCarousel />
    
    <!-- Ticker Bar - 100% Natural -->
    <TickerBar />
    
    <!-- Preços e Ofertas -->
    <Pricing />
    
    <!-- Garantia -->
    <Guarantee />
    
    <!-- FAQ -->
    <FAQ />
    
    <!-- Footer -->
    <Footer />
  </main>
</Layout>
